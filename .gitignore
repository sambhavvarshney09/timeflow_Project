```gitignore
# ===================================
# DEPENDENCIES
# ===================================
node_modules/
client/node_modules/
server/node_modules/

# ===================================
# ENVIRONMENT VARIABLES - NEVER PUSH
# ===================================
.env
.env.*
!.env.example
client/.env
client/.env.*
!client/.env.example
server/.env
server/.env.*
!server/.env.example

# ===================================
# BUILD OUTPUT
# ===================================
dist/
build/
client/dist/
server/dist/

# ===================================
# LOG FILES
# ===================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ===================================
# CACHE
# ===================================
.cache/
.parcel-cache/
.vite/
.eslintcache/

# ===================================
# TEST & COVERAGE
# ===================================
coverage/

# ===================================
# EDITOR / IDE
# ===================================
.vscode/
.idea/
*.suo
*.swp
*.swo

# ===================================
# OPERATING SYSTEM
# ===================================
.DS_Store
Thumbs.db
Desktop.ini

# ===================================
# TEMPORARY FILES
# ===================================
*.tmp
*.temp
*.bak
```
